{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "composite": true,
    "jsx": "react-jsx",
    "rootDir": ".",
    "outDir": "dist/types",
    "emitDeclarationOnly": true,
    "tsBuildInfoFile": "dist/types/app.tsbuildinfo"
  },
  "references": [
    { "path": "src/domain/model" },
    { "path": "src/domain/usecase" },
    { "path": "src/gateway/browser-calendar" },
    { "path": "src/presentation" }
  ],
  "include": [
    "src/app.tsx",
    "src/main.tsx",
    "src/vite-env.d.ts",
    "src/wire",
    "scripts/seo-metadata.ts",
    "vite.config.ts"
  ]
}
